# ─── PostgreSQL ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=esp32_tourney
DB_USER=tourney_user
DB_PASS=changeme

# ─── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── MQTT Broker ───────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=esp32
MQTT_PASS=changeme

# ─── NestJS Server ─────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Mystery Jackpot Contribution Rate (%) ─────────────────
JACKPOT_CONTRIBUTION_RATE=0.5
# Minimum payout a hit can be clamped up to. Defaults JACKPOT_INITIAL_AMOUNT
# to this same value if that's left unset.
JACKPOT_BASE_AMOUNT=10000
# Pool value right after a reset (round start / post-hit). Optional --
# defaults to JACKPOT_BASE_AMOUNT (old behavior: pool started already at the
# payout floor). Set lower to have the pool visibly climb INTO [min, max]
# from real coin-in before a hit can be reached.
JACKPOT_INITIAL_AMOUNT=10000
JACKPOT_MAX_AMOUNT=1000000
